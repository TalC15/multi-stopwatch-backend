# Existing deployment credentials: fill only in Render secret settings.
JWT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
AUTH_ALLOWED_ORIGINS=
SUBSCRIPTION_IDEMPOTENCY_HMAC_KEY=
# Phase 7: HTTPS frontend origin; must be in AUTH_ALLOWED_ORIGINS.
AUTH_PUBLIC_ORIGIN=
# Explicit production provider; no test/dev fallback.
AUTH_EMAIL_PROVIDER=
# Resend sending-only API key, verified sender domain/address.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Independently generated 32-byte keys encoded as 64 hex characters.
# Keep keys identical on all instances. Rotation invalidates pending challenges.
AUTH_TOKEN_HMAC_KEY=
AUTH_RATE_HMAC_KEY=
# No environment variable opens DB auth/sales release gates.
